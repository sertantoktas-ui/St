# Claude API Configuration
ANTHROPIC_API_KEY=your-api-key-here

# Kullanıcı Ayarları
USER_NAME=Kullanıcı Adı
USER_EMAIL=user@example.com

# Email Gönderme Ayarları (Opsiyonel)
# Gmail için: https://support.google.com/mail/answer/185833?hl=en
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-password-here

# Alternatif: Outlook
# SMTP_SERVER=smtp-mail.outlook.com
# SMTP_PORT=587

# Google NotebookLM
NOTEBOOKLM_NOTEBOOK_ID=4aa95fc5-5f77-4575-afc6-4b9e6766da6f
NOTEBOOKLM_NOTEBOOK_URL=https://notebooklm.google.com/notebook/4aa95fc5-5f77-4575-afc6-4b9e6766da6f
